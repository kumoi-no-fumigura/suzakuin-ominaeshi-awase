 "poems": [
  {
   "seq": "1",
   "text": "草かれの秋過ぬへきをみなへし匂ゆへにやまつみえぬらん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "あらかねの土の下にて秋まちてけふのうらてにあふ女郞花",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "秋のゝに女郞花みんとさしはへてぬれにし袖や花とみゆらん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "をみなへし秋のゝ風にうちなひきこゝろ一つを誰によすらん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "秋とにさきわくれともをみなへしけふまつ程の名に社有けれ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "さやかにもけさはみえすやをみなへし霧の籬にたち隱れつゝ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "をみなへしたてるの里をうち過てうらみん露にぬれや渡らん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "白露のをけるあしたのをみなへし花にも葉にも玉そかゝれる",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "秋風のふきそめしよりをみなへし色ふかくのみ見ゆる野へ哉",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "かくおらん秋にしあはゝをみなへし移ふ色は忘れやはせぬ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "長きよをたれたのみけんをみなへし人まつむしの枝とになく",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "人のみむ〓とやくるしきをみなへし秋霧にのみたちかくるらむ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "うつらすは冬ともわかし女郞花ときはの枝にさきかゝらなむ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "移しうへてけふみるからに女郞花さか野の冬はことし忘れよ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "女郞花この秋まてそまたるへき露をもぬきて玉とまとはせ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "君によりのへをはなれしをみなへしおなし心に秋をとゝめよ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "とりてみははかなからんやをみなへし袖につゝめる白露の玉",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "女郞花ふき過てくる秋風はめにはみえねとかこそしるけれ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "久かたの月人おとこをみなへしこの秋はかりうつろふなゆめ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "秋の野の露にをかるゝなみなへしはらふ人なみわれや渡らん",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "仇なれと名に社たてれをみなへしなと秋のゝに思ひそめけむ",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "をみなへし移ろふ秋の程をなみねさし移しておしむけふかな",
   "kana": "",
   "speaker": "",
   "page": 615,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
